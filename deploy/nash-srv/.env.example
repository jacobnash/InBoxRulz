# Copy to deploy/nash-srv/.env, fill in, then on nash-srv:
#   docker compose --env-file deploy/nash-srv/.env up -d --build
#
# Public config only — real secrets live in ./secrets/*, not here (see
# setup-secrets.sh and docker-compose.yml's top-level `secrets:`).

# Firebase project id (public) — same project as the web config below.
FIREBASE_PROJECT_ID=

# Firebase Web SDK config — baked into the web app's client bundle at
# build time (see Dockerfile.web). Public, not secret.
NEXT_PUBLIC_API_URL=https://api.inboxrulz.nash.engineering
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Host-side port bindings (127.0.0.1 only — Caddy fronts these). Defaults
# below match docker-compose.yml and the Caddyfile snippet in the README.
API_HOST_PORT=8090
WEB_HOST_PORT=8091
POSTGRES_HOST_PORT=5434
