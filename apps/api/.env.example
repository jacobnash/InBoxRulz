# Public config — the Firebase project ID the dashboard's client config also
# uses. Not a secret: verifying an ID token only checks its signature
# against Google's public keys and that this project ID matches.
FIREBASE_PROJECT_ID=

# Secret — encrypts connected-account credentials at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
# On a VPS/Docker host without a cloud secrets manager, prefer mounting this
# as a file and setting CREDENTIALS_ENCRYPTION_KEY_FILE to its path instead
# (Docker/Compose "secrets" convention) — either form works, see
# packages/config/src/secrets.ts.
CREDENTIALS_ENCRYPTION_KEY=
# CREDENTIALS_ENCRYPTION_KEY_FILE=/run/secrets/credentials_encryption_key

# Optional secret — omit to fall back to an in-memory store (state resets on
# restart, not shared with the worker process). Must be the exact same
# value apps/worker uses so both processes see the same accounts/rules/runs.
# postgresql://user:password@host:5432/inboxrulz
DATABASE_URL=
# DATABASE_URL_FILE=/run/secrets/database_url

# Optional secret — omit to fall back to the conservative heuristic rescue
# classifier (no LLM calls). Same _FILE convention supported.
ANTHROPIC_API_KEY=

# Optional — omit all three to fall back to the manual paste-credentials
# form on POST /accounts. From Google Cloud Console -> APIs & Services ->
# Credentials -> OAuth 2.0 Client ID (Web application), with the Gmail API
# enabled and this exact redirect URI registered.
GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_ID_FILE=/run/secrets/google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_CLIENT_SECRET_FILE=/run/secrets/google_oauth_client_secret
# Must exactly match the redirect URI registered on the OAuth client above.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Where /auth/google/callback sends the browser back to once an account is
# connected (or fails to connect).
WEB_APP_URL=http://localhost:3000

PORT=3001
# error | warn | info | debug | trace
LOG_LEVEL=info
