# Public config — the Firebase project ID the dashboard's client config also
# uses. Not a secret: verifying an ID token only checks its signature
# against Google's public keys and that this project ID matches.
FIREBASE_PROJECT_ID=

# Secret — encrypts connected-account credentials at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
# On a VPS/Docker host without a cloud secrets manager, prefer mounting this
# as a file and setting CREDENTIALS_ENCRYPTION_KEY_FILE to its path instead
# (Docker/Compose "secrets" convention) — either form works, see
# packages/config/src/secrets.ts.
CREDENTIALS_ENCRYPTION_KEY=
# CREDENTIALS_ENCRYPTION_KEY_FILE=/run/secrets/credentials_encryption_key

# Optional secret — omit to fall back to the conservative heuristic rescue
# classifier (no LLM calls). Same _FILE convention supported.
ANTHROPIC_API_KEY=

PORT=3001
# error | warn | info | debug | trace
LOG_LEVEL=info
