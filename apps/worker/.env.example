# Secret — must be the exact same value apps/api uses (both decrypt the
# same connected-account credentials). Generate with: openssl rand -base64 32
# Same _FILE convention as apps/api supported — see packages/config.
CREDENTIALS_ENCRYPTION_KEY=
# CREDENTIALS_ENCRYPTION_KEY_FILE=/run/secrets/credentials_encryption_key

# Optional secret — omit to fall back to the conservative heuristic rescue
# classifier (no LLM calls).
ANTHROPIC_API_KEY=

# Standard cron expression; default is daily at 6am.
CRON_SCHEDULE=0 6 * * *

# error | warn | info | debug | trace
LOG_LEVEL=info
